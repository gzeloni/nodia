import "./helpers" as helpers
import "./helpers" show title, version
import "./helpers" as public hide internal

const project = "Dobra"
let total = 0
const items = ["alpha", "beta", "gamma"]
const meta = {
  name: project,
  count: len(items),
  "release-channel": version,
}

fn add(left, right) {
  return left + right
}

fn classify(n) {
  if n < 0 {
    return "negative"
  } else if n == 0 {
    return "zero"
  } else {
    return "positive"
  }
}

for item in items {
  emit title(item)
}

while total < 3 {
  total = total + 1
}

emit public.banner(project)
emit meta.name
emit classify(add(total, -3))
