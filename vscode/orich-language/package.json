{
  "name": "orich-language",
  "displayName": "Orich Language",
  "description": "Syntax highlighting and editor configuration for Orich files.",
  "version": "0.1.0",
  "publisher": "orich",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "orich",
        "aliases": [
          "Orich",
          "orich"
        ],
        "extensions": [
          ".och"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "orich",
        "scopeName": "source.orich",
        "path": "./syntaxes/orich.tmLanguage.json"
      }
    ]
  }
}
