{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nodia",
  "scopeName": "source.nodia",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nodia",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.nodia",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.nodia",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.nodia",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nodia",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.nodia",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.nodia"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.nodia"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nodia",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nodia",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nodia",
          "match": "\\b(?:if|else|for|in|while|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.nodia",
          "match": "\\b(?:val|var|func)\\b"
        },
        {
          "name": "keyword.operator.logical.nodia",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.other.emit.nodia",
          "match": "\\bemit\\b"
        },
        {
          "name": "keyword.other.use.nodia",
          "match": "\\b(?:use|as|pick|hide)\\b"
        },
        {
          "name": "constant.language.nodia",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.nodia",
          "match": "\\b(?:let|const|fn|import|show|from|match|case|default|try|catch|throw|defer|type|enum|struct|namespace)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nodia",
          "match": "\\b(?:upper|lower|uppercase|lowercase|capitalize|trim|replace|split|join|lines|unlines|words|contains|starts|ends|starts_with|ends_with|indent|dedent|open|close|flush|read|readln|write|writeln|append|eof|keys|values|len|int|float|string|bool|range|abs|floor|ceil|round|sqrt|pow|min|max|clamp|sum|avg|push|pop|first|last|slice|reverse|sort|unique)\\b(?=\\s*\\()"
        },
        {
          "name": "variable.language.input.nodia",
          "match": "\\b(?:input|stdin|stdout|stderr)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.nodia",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.nodia"
            },
            "2": {
              "name": "entity.name.function.nodia"
            }
          }
        },
        {
          "name": "meta.variable.nodia",
          "match": "\\b(val|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.nodia"
            },
            "2": {
              "name": "variable.other.definition.nodia"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.nodia",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.nodia",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.nodia",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nodia",
          "match": "[,.:;]"
        },
        {
          "name": "punctuation.bracket.nodia",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
