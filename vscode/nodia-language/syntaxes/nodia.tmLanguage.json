{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nodia",
  "scopeName": "source.nodia",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#useStatements"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#globals"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#memberAccess"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nodia",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.nodia",
          "match": "//.*$"
        },
        {
          "name": "comment.block.nodia",
          "begin": "/\\*",
          "end": "\\*/",
          "patterns": []
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.triple.nodia",
          "begin": "r?\"\"\"",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.raw.triple.delimiter.nodia"
            }
          },
          "end": "\"\"\"",
          "patterns": []
        },
        {
          "name": "string.quoted.raw.double.nodia",
          "begin": "r\"",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.raw.double.delimiter.nodia"
            }
          },
          "end": "\"",
          "patterns": []
        },
        {
          "name": "string.quoted.raw.single.nodia",
          "begin": "r'",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.raw.single.delimiter.nodia"
            }
          },
          "end": "'",
          "patterns": []
        },
        {
          "name": "string.quoted.bytes.double.nodia",
          "begin": "b\"",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.bytes.double.delimiter.nodia"
            }
          },
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.bytes.single.nodia",
          "begin": "b'",
          "beginCaptures": {
            "0": {
              "name": "string.quoted.bytes.single.delimiter.nodia"
            }
          },
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.nodia",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.nodia",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.nodia",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.nodia",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.nodia"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.nodia"
            }
          },
          "contentName": "meta.embedded.inline.nodia",
          "patterns": [
            {
              "include": "#embeddedExpression"
            }
          ]
        }
      ]
    },
    "embeddedExpression": {
      "patterns": [
        {
          "include": "#embeddedStrings"
        },
        {
          "include": "#embeddedBraces"
        },
        {
          "include": "#comments"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#globals"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#memberAccess"
        },
        {
          "include": "#embeddedIdentifiers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "embeddedStrings": {
      "patterns": [
        {
          "name": "string.quoted.embedded.double.nodia",
          "match": "\\\\\"(?:\\\\.|[^\"\\\\])*\\\\\""
        },
        {
          "name": "string.quoted.embedded.single.nodia",
          "match": "\\\\'(?:\\\\.|[^'\\\\])*\\\\'"
        },
        {
          "name": "constant.character.escape.nodia",
          "match": "\\\\."
        }
      ]
    },
    "embeddedBraces": {
      "patterns": [
        {
          "name": "meta.embedded.block.nodia",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.bracket.nodia"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.bracket.nodia"
            }
          },
          "contentName": "meta.embedded.block.content.nodia",
          "patterns": [
            {
              "include": "#embeddedExpression"
            }
          ]
        }
      ]
    },
    "embeddedIdentifiers": {
      "patterns": [
        {
          "name": "variable.other.readwrite.nodia",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.nodia",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.nodia",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nodia",
          "match": "\\b(?:if|else|for|in|while|break|continue|return|lambda|match|case|default|try|catch|throw)\\b"
        },
        {
          "name": "keyword.declaration.nodia",
          "match": "\\b(?:val|var|func|namespace|struct|enum|type)\\b"
        },
        {
          "name": "keyword.operator.logical.nodia",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.other.emit.nodia",
          "match": "\\bemit\\b"
        },
        {
          "name": "keyword.other.regex.nodia",
          "match": "\\bregex\\b"
        },
        {
          "name": "keyword.other.use.nodia",
          "match": "\\b(?:use|as|pick|hide)\\b"
        },
        {
          "name": "constant.language.nodia",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.nodia",
          "match": "\\b(?:let|const|fn|import|show|from|defer)\\b"
        }
      ]
    },
    "useStatements": {
      "patterns": [
        {
          "name": "meta.use.nodia",
          "begin": "\\buse\\b",
          "beginCaptures": {
            "0": {
              "name": "keyword.other.use.nodia"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "name": "keyword.other.use.nodia",
              "match": "\\b(?:as|pick|hide)\\b"
            },
            {
              "name": "support.module.stdlib.nodia",
              "match": "\\b(?:text|numbers|conversion|collections|format|io|scan|system|datetime|json|csv|http|log|test)\\b"
            },
            {
              "name": "meta.use.alias.nodia",
              "match": "\\b(as)\\s+([A-Za-z_][A-Za-z0-9_]*)",
              "captures": {
                "1": {
                  "name": "keyword.other.use.nodia"
                },
                "2": {
                  "name": "entity.name.namespace.nodia"
                }
              }
            }
          ]
        },
        {
          "name": "meta.use.selection.nodia",
          "match": "\\b(pick|hide)\\b\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\s*,\\s*[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "keyword.other.use.nodia"
            },
            "2": {
              "name": "variable.other.readwrite.nodia"
            }
          }
        }
      ]
    },
    "globals": {
      "patterns": [
        {
          "name": "variable.language.input.nodia",
          "match": "\\binput\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.nodia",
          "match": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.nodia"
            },
            "2": {
              "name": "entity.name.function.nodia"
            }
          }
        },
        {
          "name": "meta.variable.nodia",
          "match": "\\b(val|var)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.nodia"
            },
            "2": {
              "name": "variable.other.definition.nodia"
            }
          }
        },
        {
          "name": "meta.namespace.nodia",
          "match": "\\b(namespace)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.namespace.nodia"
            },
            "2": {
              "name": "entity.name.namespace.nodia"
            }
          }
        },
        {
          "name": "meta.struct.nodia",
          "match": "\\b(struct)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.struct.nodia"
            },
            "2": {
              "name": "entity.name.type.nodia"
            }
          }
        },
        {
          "name": "meta.enum.nodia",
          "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.enum.nodia"
            },
            "2": {
              "name": "entity.name.type.enum.nodia"
            }
          }
        },
        {
          "name": "meta.type.nodia",
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.nodia"
            },
            "2": {
              "name": "entity.name.type.nodia"
            }
          }
        },
        {
          "name": "meta.catch.nodia",
          "match": "\\b(catch)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.nodia"
            },
            "2": {
              "name": "variable.other.definition.nodia"
            }
          }
        }
      ]
    },
    "memberAccess": {
      "patterns": [
        {
          "name": "meta.member.access.nodia",
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.dot.nodia"
            },
            "2": {
              "name": "variable.other.member.nodia"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.bitwise.nodia",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.comparison.nodia",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.nodia",
          "match": "\\+=|-=|="
        },
        {
          "name": "keyword.operator.arithmetic.nodia",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.nodia",
          "match": "[,.:;]"
        },
        {
          "name": "punctuation.bracket.nodia",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
