{
  "name": "nodia-language",
  "displayName": "Nodia Language",
  "description": "Editor support for Nodia with syntax highlighting and stdlib-aware completions.",
  "version": "0.6.2",
  "publisher": "nodia",
  "license": "GPL-3.0-or-later",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:nodia"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "nodia",
    "stdlib",
    "json",
    "csv",
    "regex"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nodia",
        "aliases": [
          "Nodia",
          "nodia"
        ],
        "extensions": [
          ".nod"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nodia",
        "scopeName": "source.nodia",
        "path": "./syntaxes/nodia.tmLanguage.json"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  }
}
