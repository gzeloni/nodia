{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Dobra",
  "scopeName": "source.dobra",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.dobra",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.dobra",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.dobra",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.dobra",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.dobra",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.dobra",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.dobra",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#interpolation"
            },
            {
              "name": "constant.character.escape.dobra",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "interpolation": {
      "patterns": [
        {
          "name": "meta.interpolation.dobra",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.dobra"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.dobra"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.dobra",
          "match": "\\b\\d+\\.\\d+\\b"
        },
        {
          "name": "constant.numeric.integer.dobra",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.dobra",
          "match": "\\b(?:if|else|for|in|while|break|continue|return)\\b"
        },
        {
          "name": "keyword.declaration.dobra",
          "match": "\\b(?:let|const|fn)\\b"
        },
        {
          "name": "keyword.operator.logical.dobra",
          "match": "\\b(?:and|or|not)\\b"
        },
        {
          "name": "keyword.other.emit.dobra",
          "match": "\\bemit\\b"
        },
        {
          "name": "keyword.other.import.dobra",
          "match": "\\b(?:import|from|as|show|hide)\\b"
        },
        {
          "name": "constant.language.dobra",
          "match": "\\b(?:true|false|null)\\b"
        },
        {
          "name": "invalid.deprecated.reserved.dobra",
          "match": "\\b(?:match|case|default|try|catch|throw|defer|type|enum|struct|namespace|use)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.dobra",
          "match": "\\b(?:upper|lower|uppercase|lowercase|capitalize|trim|replace|split|join|lines|unlines|words|contains|starts|ends|starts_with|ends_with|indent|dedent|open|close|flush|read|readln|write|writeln|append|eof|keys|values|len|int|float|string|bool|range|abs|floor|ceil|round|sqrt|pow|min|max|clamp|sum|avg|push|pop|first|last|slice|reverse|sort|unique)\\b(?=\\s*\\()"
        },
        {
          "name": "variable.language.input.dobra",
          "match": "\\b(?:input|stdin|stdout|stderr)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.dobra",
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.dobra"
            },
            "2": {
              "name": "entity.name.function.dobra"
            }
          }
        },
        {
          "name": "meta.variable.dobra",
          "match": "\\b(let|const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.variable.dobra"
            },
            "2": {
              "name": "variable.other.definition.dobra"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.dobra",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.dobra",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.dobra",
          "match": "\\+|-|\\*|/|%"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.dobra",
          "match": "[,.:;]"
        },
        {
          "name": "punctuation.bracket.dobra",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
