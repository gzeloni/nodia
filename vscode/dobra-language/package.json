{
  "name": "dobra-language",
  "displayName": "Dobra Language",
  "description": "Syntax highlighting and editor configuration for Dobra files.",
  "version": "0.3.0",
  "publisher": "dobra",
  "license": "GPL-3.0-or-later",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "dobra",
        "aliases": [
          "Dobra",
          "dobra"
        ],
        "extensions": [
          ".dob"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "dobra",
        "scopeName": "source.dobra",
        "path": "./syntaxes/dobra.tmLanguage.json"
      }
    ]
  }
}
