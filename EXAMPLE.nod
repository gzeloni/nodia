# Nodia 0.7.1 end-to-end example.
#
# Basic run:
# ./target/debug/nodia run EXAMPLE.nod -- one two
#
# Optional process section:
# ./target/debug/nodia run EXAMPLE.nod --allow-process --var run_process=true
#
# Optional environment section:
# HOME=/tmp ./target/debug/nodia run EXAMPLE.nod --allow-env --var run_env=true
#
# Optional file IO section:
# ./target/debug/nodia run EXAMPLE.nod --allow-write --var run_file_io=true --var output_path=/tmp/nodia-example.txt
#
# Optional stderr demo:
# ./target/debug/nodia run EXAMPLE.nod --var show_stderr=true
use text
use numbers
use conversion as conv
use collections as col
use format as fmt
use re
use io
use system
use datetime
use json
use csv

func section(title) {
  emit ""
  emit "== {title} =="
}

func size_bucket(n) {
  if n < 5 {
    return "small"
  }

  return "big"
}

section("Text And Unicode")
val messy = "  ana   bruno\tcarla  "
val unicode = "aéb"
val composed = "é"
val decomposed = "é"
val circled = "①"
val street = "Straße"
emit text.trim(messy)
emit text.words(messy)
emit text.replace(
  "ana 42 bruno 77",
  regex {
    one_or_more digit
  },
  "#",
)
emit "scalars={col.len(unicode)} " +
  "bytes={text.byte_len(unicode)}"
emit "scalar->byte(2)={text.byte_offset(unicode, 2)}"
emit "byte->scalar(3)={text.scalar_offset(unicode, 3)}"
emit "raw-eq={composed == decomposed}"
emit "nfc-eq={text.nfc(composed) == text.nfc(decomposed)}"
emit "nfkc(①)={text.nfkc(circled)}"
emit "casefold={text.casefold(street)}"
section("Collections And Numbers")
val values = [3, 1, 4, 1, 5, 9]
emit col.sort(values)
emit numbers.sum(values)
emit fmt.fixed(numbers.avg(values), 2)
emit col.map(numbers.int, ["7", "8", "9"])
emit col.reduce(
  lambda(acc, x) {
    return acc + x
  },
  0,
  values,
)
emit col.group_by(size_bucket, values)
var counts = {}

for word in text.words("ana bruno ana carla ana") {
  counts[word] = col.get(counts, word, 0) + 1
}

emit counts
section("Regex")
val url = regex(case_insensitive) {
  named scheme {
    either {
      branch {
        "http"
      }
      branch {
        "https"
      }
    }
  }
  "://"
  named host {
    one_or_more {
      char_set {
        letter
        digit
        "."
        "-"
      }
    }
  }
}
val sample = "go to https://example.com/docs now"
val hit = re.find(sample, url)
emit re.test(sample, url)
emit hit.text
emit hit.named.scheme
emit hit.named.host
emit col.slice(sample, 0, hit.start)
section("JSON And CSV")
val doc = json.read(
  "{{\"name\":\"Ana\",\"active\":true,\"scores\":[7,8,9]}}",
)
val rows = csv.read(
  "name,age\nAna,30\nBia,25",
  {
    header: true,
    types: true,
  },
)
emit doc.name
emit json.write(doc, 2)
emit rows[1].age + 5
emit csv.write(rows)
section("Date And Time")
val base = datetime.parse_datetime("2024-01-31T23:00:00Z")
val next = datetime.add_duration(
  base,
  datetime.duration(
    {
      hours: 2,
      minutes: 30,
    },
  ),
)
emit datetime.isoformat(
  datetime.add_months(datetime.date(2024, 1, 31), 1),
)
emit datetime.isoformat(next)
emit datetime.strftime(next, "%F %T %:z")
emit datetime.weekday_name(datetime.date(2026, 6, 6))
section("Formatting And Conversion")
emit fmt.format(
  "%05d %.2f %-5s",
  [7, 3.5, conv.string(doc.active)],
)
emit conv.bool([])
emit conv.string(
  {
    status: "ok",
    total: numbers.sum(values),
  },
)
section("Runtime And Streams")
emit system.args
io.write(io.stdout, "stdout via io.write\n")

if col.get(input, "show_stderr", false) {
  io.writeln(io.stderr, "stderr via io.writeln")
}

if col.get(input, "run_process", false) {
  section("Optional Process")
  val result = system.exec(
    "/bin/sh",
    ["-c", "printf out; printf err 1>&2; exit 7"],
  )
  emit result.stdout
  emit result.stderr
  emit result.status
}

if col.get(input, "run_env", false) {
  section("Optional Environment")
  emit system.env("HOME")
}

if col.get(input, "run_file_io", false) {
  section("Optional File IO")
  val path = col.get(
    input,
    "output_path",
    "/tmp/nodia-example.txt",
  )
  io.write(path, "generated by nodia 0.7.1\n")
  io.append(path, "sum={numbers.sum(values)}\n")
  emit io.basename(path)
  emit io.exists(path)
  emit io.read(path)
}
