# Nodia 0.8.0 end-to-end example.
#
# Basic run:
# ./target/debug/nodia run EXAMPLE.nod -- one two
#
# Optional process section:
# ./target/debug/nodia run EXAMPLE.nod --allow-process --var run_process=true
#
# Optional environment section:
# HOME=/tmp ./target/debug/nodia run EXAMPLE.nod --allow-env --var run_env=true
#
# Optional file IO section:
# ./target/debug/nodia run EXAMPLE.nod --allow-write --var run_file_io=true --var output_path=/tmp/nodia-example.txt
#
# Optional stderr demo:
# ./target/debug/nodia run EXAMPLE.nod --var show_stderr=true
use text
use numbers
use conversion as conv
use collections as col
use format as fmt
use re
use io
use system
use result
use datetime
use json
use csv

func section(title) {
  emit ""
  emit "== {title} =="
}

func size_bucket(n) {
  if n < 5 {
    return "small"
  }

  return "big"
}

section("Text, Bytes, And Unicode")
val messy = "  ana   bruno\tcarla  "
val unicode = "aéb"
val encoded = text.encode(unicode, text.utf8)
val composed = "é"
val decomposed = "é"
val circled = "①"
val street = "Straße"
val noisy = b"\xef\xbb\xbfa\r\nb\0\xff"
var packet = b"a\0\xffb"
emit text.trim(messy)
emit text.words(messy)
emit text.replace(
  "ana 42 bruno 77",
  regex {
    one_or_more digit
  },
  "#",
)
emit "scalars={text.len(unicode, text.scalar)} " + "bytes={text.len(unicode, text.byte)}"
emit 'scalar->byte(2)={text.offset(unicode, text.scalar, text.byte, 2)}'
emit 'byte->scalar(3)={text.offset(unicode, text.byte, text.scalar, 3)}'
emit 'graphemes={text.len(decomposed + "x", text.grapheme)}'
emit 'scalar-slice={text.slice(decomposed + "x", text.scalar, 0, 2)}'
emit 'grapheme-slice={text.slice(decomposed + "x", text.grapheme, 0, 1)}'
emit "byte-slice={text.slice(unicode, text.byte, 1, 3)}"
emit "raw-eq={composed == decomposed}"
emit 'nfc-eq={text.normalize(composed, text.nfc) == text.normalize(decomposed, text.nfc)}'
emit "nfkc(①)={text.normalize(circled, text.nfkc)}"
emit "casefold={text.casefold(street)}"
emit encoded
emit "encoded-slice={col.slice(encoded, 1, 3)}"
packet[1] = 120
emit packet
emit "encode/decode={text.decode(encoded, text.utf8)}"
emit text.normalize(
  text.drop_nul(
    text.strip_bom(
      text.decode(noisy, text.utf8, text.lossy),
    ),
  ),
  text.lf,
)
section("Collections And Numbers")
val values = [3, 1, 4, 1, 5, 9]
emit col.sort(values)
emit numbers.sum(values)
emit fmt.fixed(numbers.avg(values), 2)
emit col.map(numbers.int, ["7", "8", "9"])
emit col.reduce(
  lambda(acc, x) {
    return acc + x
  },
  0,
  values,
)
emit col.group_by(size_bucket, values)
var counts = {}

for word in text.words("ana bruno ana carla ana") {
  counts[word] = col.get(counts, word, 0) + 1
}

emit counts
section("Regex")
val url = regex(case_insensitive) {
  named scheme {
    either {
      branch {
        "http"
      }
      branch {
        "https"
      }
    }
  }
  "://"
  named host {
    one_or_more {
      char_set {
        letter
        digit
        "."
        "-"
      }
    }
  }
}
val sample = "go to https://example.com/docs now"
val hit = re.find(sample, url)
emit re.test(sample, url)
emit hit.text
emit hit.named.scheme
emit hit.named.host
emit col.slice(sample, 0, hit.start)
section("JSON And CSV")
val doc = json.read(
  text.encode(
    r'{"name":"Ana","active":true,"scores":[7,8,9]}',
    text.utf8,
  ),
)
val rows = csv.read(
  text.encode("name,age\nAna,30\nBia,25", text.utf8),
  {
    header: true,
    types: true,
  },
)
emit doc.name
emit json.write(doc, 2)
emit rows[1].age + 5
emit csv.write(rows)
section("Date And Time")
val base = datetime.parse(
  "2024-01-31T23:00:00Z",
  datetime.as_datetime,
)
val next = datetime.add(
  base,
  datetime.duration(
    {
      hours: 2,
      minutes: 30,
    },
  ),
)
emit datetime.isoformat(
  datetime.add(
    datetime.date(2024, 1, 31),
    1,
    datetime.months,
  ),
)
emit datetime.isoformat(next)
emit datetime.strftime(next, "%F %T %:z")
emit datetime.weekday_name(datetime.date(2026, 6, 6))
section("Formatting And Conversion")
emit fmt.format(
  "%05d %.2f %-5s",
  [7, 3.5, conv.string(doc.active)],
)
emit fmt.format("[%2s][%.1s]", ["é", "éx"])
emit conv.bool([])
emit conv.string(
  {
    status: "ok",
    total: numbers.sum(values),
  },
)
section("Recoverable Results")
val ok_name = result.ok(doc.name)
val missing_row = result.err("E8000", "optional row missing")
emit ok_name
emit result.is_ok(ok_name)
emit result.value(ok_name)
emit result.is_err(missing_row)
emit result.error(missing_row).code
emit result.error(missing_row).message
section("Runtime And Streams")
emit system.args
io.write(io.stdout, "stdout via io.write\n")

if col.get(input, "show_stderr", false) {
  io.writeln(io.stderr, "stderr via io.writeln")
}

if col.get(input, "run_process", false) {
  section("Optional Process")
  val result = system.exec(
    "/bin/sh",
    ["-c", "printf out; printf err 1>&2; exit 7"],
  )
  emit text.decode(result.stdout, text.utf8)
  emit text.decode(result.stderr, text.utf8)
  emit result.status
}

if col.get(input, "run_env", false) {
  section("Optional Environment")
  emit system.env("HOME")
}

if col.get(input, "run_file_io", false) {
  section("Optional File IO")
  val path = col.get(
    input,
    "output_path",
    "/tmp/nodia-example.txt",
  )
  io.write(path, "generated by nodia 0.8.0\n")
  io.append(path, "sum={numbers.sum(values)}\n")
  emit io.basename(path)
  emit io.exists(path)
  emit io.read(path)
}
